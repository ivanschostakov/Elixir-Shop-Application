{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "environment": "preview",
      "distribution": "internal"
    },
    "internal": {
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production",
      "distribution": "internal"
    },
    "testing": {
      "environment": "production",
      "env": {
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      },
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.2"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "testflight": {
      "environment": "production",
      "env": {
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      },
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.2"
      }
    },
    "production": {
      "environment": "production",
      "env": {
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      },
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "channel": "production",
        "env": {
          "ELIXIR_ANDROID_STORE": "1"
        }
      },
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.2"
      }
    }
  },
  "submit": {
    "internalTesting": {
      "android": {
        "track": "internal"
      }
    },
    "closedTesting": {
      "android": {
        "track": "closed"
      }
    },
    "testflight": {},
    "production": {
      "ios": {
        "ascAppId": "6817568156"
      },
      "android": {
        "track": "production",
        "releaseStatus": "completed"
      }
    }
  }
}
